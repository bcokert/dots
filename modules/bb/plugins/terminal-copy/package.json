  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
